<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - TradeNShare</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" type="image/png" href="images/favicon.png">
</head>
<style>
    /* General Page Styling */
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f4f9;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }

    h1 {
        color: white;
        padding: 10px;
        background-color: black;
        text-align: center;
        margin-bottom: 20px;
    }

    /* Container */
    .container {
        background: #ffffff;
        width: 90%;
        max-width: 600px;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    /* Back Button */
    button {
    background: black;
    color: #fff;
    border: none;
    padding: 10px 15px;
    font-size: 16px;
    border-radius: 5px;
    cursor: pointer;
    transition: background 0.3s ease;
    margin-bottom: 20px;
    }

    button:hover {
        background: #333;
    }

    /* Comments List */
    .comments-list {
        width: 100%;
    }

    .comment {
        background: lightgrey;
        color: black;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 10px;
        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    }

    .comment p {
        margin: 5px 0;
        font-size: 14px;
        color: #2c3e50;
    }

    strong {
        color: #34495e;
    }

    /* Separator Line */
    hr {
        border: none;
        height: 1px;
        background: #bdc3c7;
        margin: 10px 0;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .container {
            width: 95%;
            padding: 20px;
        }
    }
</style>

<body>
    <div class="container">
        <h1>Comments for <%= user.name %></h1>

        <div class="comments-list">
            <% comments.forEach((comment, index) => { %>
                <div class="comment">
                    <p><strong>Comment <%= index + 1 %>:</strong></p>
                    <p><strong>Rating:</strong> <%= comment.rating %> / 5</p>
                    <p><strong>Comment:</strong> <%= comment.comment %></p>
                    <p><strong>Date:</strong> <%= comment.review_date.toLocaleString() %></p>
                </div>
                <hr>
            <% }) %>

        </div>
        <button onclick="window.history.back()">Back</button>

    </div>
</body>
</html>